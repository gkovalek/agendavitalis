{
  "name": "Vitalis - Envio de Recordatorios WA",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "vitalis-recordatorios",
        "responseMode": "onReceived",
        "responseData": ""
      },
      "id": "node-wh-01",
      "name": "Webhook Vitalis",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "vitalis-recordatorios"
    },
    {
      "parameters": {
        "jsCode": "// Extrae el array de turnos del body y prepara un item por cada uno\nconst body = $input.first().json.body;\nconst turnos = body.turnos || [];\nconst centroNombre = body.centro_nombre || 'el centro';\nconst centroDireccion = body.centro_direccion || '';\n\nreturn turnos.map(t => ({\n  json: {\n    turno_id:     t.turno_id,\n    to:           String(t.celular).startsWith('+') ? t.celular : '+' + String(t.celular),\n    nombre:       t.paciente_nombre,\n    dia:          t.fecha.split('-').reverse().join('/'),\n    hora:         t.hora.substring(0, 5),\n    servicio:     t.servicio || '',\n    profesional:  t.profesional || '',\n    centro_nombre: centroNombre,\n    direccion:    centroDireccion\n  }\n}));"
      },
      "id": "node-code-01",
      "name": "Preparar items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "https://api.ycloud.com/v2/whatsapp/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env['YCLOUD_API_KEY'] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": "={\n  \"from\": \"+5493625456570\",\n  \"to\": \"{{ $json.to }}\",\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"template_utility_20260916104443\",\n    \"language\": { \"code\": \"es_AR\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": \"{{ $json.nombre }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.dia }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.hora }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.servicio }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.profesional }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.centro_nombre }}\" },\n          { \"type\": \"text\", \"text\": \"{{ $json.direccion }}\" }\n        ]\n      }\n    ]\n  }\n}",
        "options": {}
      },
      "id": "node-ycloud-01",
      "name": "Enviar WA YCloud",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Webhook Vitalis": {
      "main": [
        [{ "node": "Preparar items", "type": "main", "index": 0 }]
      ]
    },
    "Preparar items": {
      "main": [
        [{ "node": "Enviar WA YCloud", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
