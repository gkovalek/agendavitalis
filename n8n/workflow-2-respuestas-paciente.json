          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={\"estado\": \"confirmado\"}",
        "options": {}
      },
      "id": "node-supa-confirm",
      "name": "Supabase: confirmar turno",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 160]
