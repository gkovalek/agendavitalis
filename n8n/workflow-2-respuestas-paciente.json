{
  "name": "Vitalis - Respuestas WhatsApp Twilio",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "twilio-respuestas",
        "responseMode": "onReceived",
        "responseData": ""
      },
      "id": "node-wh-02",
      "name": "Webhook Twilio Respuestas",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "twilio-respuestas"
    },
    {
      "parameters": {
        "jsCode": "// Twilio envia form-urlencoded. Extraemos Body y From.\nconst body = $input.first().json.body;\n\nconst fromRaw = body.From || '';\nconst celular = fromRaw.replace('whatsapp:+', '').replace('whatsapp:', '').replace('+', '');\nconst mensaje = (body.Body || '').toLowerCase().trim();\n\nconst hoy = new Date();\nconst manana = new Date(hoy);\nmanana.setDate(manana.getDate() + 1);\nconst fmt = d => d.toISOString().split('T')[0];\n\nreturn [{ json: { celular, mensaje, mensaje_original: body.Body || '', from_raw: fromRaw, fecha_desde: fmt(hoy), fecha_hasta: fmt(manana) } }];"
      },
      "id": "node-code-02",
      "name": "Extraer datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },

    {
      "parameters": {
        "url": "={{ $env['SUPABASE_URL'] }}/rest/v1/conversaciones_wa?celular=eq.{{ $json.celular }}&estado=eq.reagendando_twilio&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env['SUPABASE_SERVICE_KEY'] }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env['SUPABASE_SERVICE_KEY'] }}" }
          ]
        },
        "options": {}
      },
      "id": "node-check-reagendar",
      "name": "Check reagendar pendiente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "cond-reagendando",
              "leftValue": "={{ $json.length ?? 0 }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-reagendando",
      "name": "En flujo reagendar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },

    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env['SUPABASE_URL'] }}/functions/v1/wa-reagendar-twilio",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env['SUPABASE_SERVICE_KEY'] }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ celular: $('Extraer datos').first().json.celular, mensaje: $('Extraer datos').first().json.mensaje_original }) }}",
        "options": {}
      },
      "id": "node-reagendar-ef",
      "name": "wa-reagendar-twilio EF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 160]
    },
    {
      "parameters": {
        "jsCode": "const efReply = $input.first().json.reply ?? '';\nconst celular = $('Extraer datos').first().json.from_raw;\nreturn [{ json: { reply: efReply, from_raw: celular } }];"
      },
      "id": "node-prep-reply-reagendar",
      "name": "Prep reply reagendar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 160]
    },
    {
      "parameters": {
        "url": "https://api.twilio.com/2010-04-01/Accounts/REEMPLAZAR_CON_ACCOUNT_SID/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            { "name": "From", "value": "whatsapp:+5493625456570" },
            { "name": "To", "value": "={{ $json.from_raw }}" },
            { "name": "Body", "value": "={{ $json.reply }}" }
          ]
        },
        "options": {}
      },
      "id": "node-twilio-reagendar-send",
      "name": "WA: enviar respuesta reagendar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1560, 160],
      "credentials": {
        "httpBasicAuth": {
          "id": "REEMPLAZAR_CON_ID_CREDENCIAL",
          "name": "REEMPLAZAR_CON_NOMBRE_CREDENCIAL_TWILIO"
        }
      }
    },

    {
      "parameters": {
        "url": "={{ $env['SUPABASE_URL'] }}/rest/v1/turnos?select=id,estado,fecha,hora_inicio,profesional_id,servicio_id,paciente:pacientes!inner(id,celular)&paciente.celular=eq.{{ $('Extraer datos').first().json.celular }}&fecha=gte.{{ $('Extraer datos').first().json.fecha_desde }}&fecha=lte.{{ $('Extraer datos').first().json.fecha_hasta }}&estado=in.(reservado,confirmado,en_sala)&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env['SUPABASE_SERVICE_KEY'] }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env['SUPABASE_SERVICE_KEY'] }}" }
          ]
        },
        "options": {}
      },
      "id": "node-supa-find",
      "name": "Buscar turno en Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 380]
    },
    {
      "parameters": {
        "jsCode": "const turno = $input.first().json[0] || null;\nconst prev  = $('Extraer datos').first().json;\n\nif (!turno) {\n  return [{ json: { turno_found: false, mensaje: prev.mensaje, from_raw: prev.from_raw } }];\n}\n\nreturn [{\n  json: {\n    turno_found:    true,\n    turno_id:       turno.id,\n    profesional_id: turno.profesional_id,\n    servicio_id:    turno.servicio_id,\n    estado_actual:  turno.estado,\n    mensaje:        prev.mensaje,\n    from_raw:       prev.from_raw,\n    celular:        prev.celular\n  }\n}];"
      },
      "id": "node-code-03",
      "name": "Combinar turno + mensaje",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 380]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": false },
          "conditions": [
            {
              "id": "cond-found",
              "leftValue": "={{ $json.turno_found }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "node-if-found",
      "name": "Turno encontrado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 380]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": false },
                "conditions": [{ "leftValue": "={{ $json.mensaje }}", "rightValue": "confirmo el turno.", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputKey": "confirmar"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false },
                "conditions": [{ "leftValue": "={{ $json.mensaje }}", "rightValue": "cancelar turno", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputKey": "cancelar"
            },
            {
              "conditions": {
                "options": { "caseSensitive": false },
                "conditions": [{ "leftValue": "={{ $json.mensaje }}", "rightValue": "reprogramar turno", "operator": { "type": "string", "operation": "equals" } }]
              },
              "renameOutput": true,
              "outputKey": "reagendar"
            }
          ]
        },
        "options": {}
      },
      "id": "node-switch",
      "name": "Switch accion",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "url": "={{ $env['SUPABASE_URL'] }}/rest/v1/turnos?id=eq.{{ $json.turno_id }}",
        "method": "PATCH",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env['SUPABASE_SERVICE_KEY'] }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env['SUPABASE_SERVICE_KEY'] }}" },
