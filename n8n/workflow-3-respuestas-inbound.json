      "id": "node-get-ocupados",
      "name": "Obtener Turnos Ocupados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 480]
    },
    {
      "parameters": {
        "jsCode": "// Recopilar datos de nodos anteriores\nconst turnoActual = $('Obtener Turno Actual').first().json[0];\nconst pcs = $('Obtener PCS').first().json[0];\nconst horarios = $('Obtener Horarios').all().map(i => i.json).flat();\nconst ocupadosRaw = $('Obtener Turnos Ocupados').all().map(i => i.json).flat();\nconst fromRaw = $('Combinar').first().json.from_raw;\n\nif (!turnoActual || !pcs || !horarios.length) {\n  return [{ json: {\n    from_raw: fromRaw,\n    mensaje: '¡Entendido! Para reagendar escribinos directamente: https://wa.me/543624075957?text=Hola%2C+quiero+reagendar+mi+turno'\n  }}];\n}\n\nconst prof = pcs.profesionales;\nconst servicio = pcs.servicios;\nconst duracion = servicio?.duracion_minutos ?? 60;\n\n// Mapa de horarios por día de semana\nconst horarioMap = {};\nfor (const h of horarios) {\n  if (!horarioMap[h.dia_semana]) horarioMap[h.dia_semana] = [];\n  horarioMap[h.dia_semana].push({ inicio: h.hora_inicio, fin: h.hora_fin });\n}\n\n// Set de slots ocupados\nconst ocupados = new Set(ocupadosRaw.map(t => `${t.fecha}T${t.hora_inicio}`));\n\n// Generar slots disponibles en los próximos 14 días (saltando hoy)\nconst slots = [];\nconst hoy = new Date();\nhoy.setHours(0, 0, 0, 0);\n\nfor (let dia = 1; dia <= 14 && slots.length < 5; dia++) {\n  const fecha = new Date(hoy);\n  fecha.setDate(hoy.getDate() + dia);\n  const diaSemana = fecha.getDay(); // 0=domingo\n  const franjas = horarioMap[diaSemana];\n  if (!franjas) continue;\n\n  const yyyy = fecha.getFullYear();\n  const mm = String(fecha.getMonth() + 1).padStart(2, '0');\n  const dd = String(fecha.getDate()).padStart(2, '0');\n  const fechaStr = `${yyyy}-${mm}-${dd}`;\n\n  const diasNombres = ['dom','lun','mar','mié','jue','vie','sáb'];\n  const mesesNombres = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];\n  const fechaLabel = `${diasNombres[diaSemana]} ${dd}/${mesesNombres[fecha.getMonth()]}`;\n\n  for (const franja of franjas) {\n    const [hIni, mIni] = franja.inicio.split(':').map(Number);\n    const [hFin, mFin] = franja.fin.split(':').map(Number);\n    let minutos = hIni * 60 + mIni;\n    const finMinutos = hFin * 60 + mFin;\n\n    while (minutos + duracion <= finMinutos && slots.length < 5) {\n      const hh = String(Math.floor(minutos / 60)).padStart(2, '0');\n      const mn = String(minutos % 60).padStart(2, '0');\n      const horaStr = `${hh}:${mn}:00`;\n      const key = `${fechaStr}T${horaStr}`;\n\n      if (!ocupados.has(key)) {\n        slots.push({ fecha: fechaStr, hora: horaStr, label: `${fechaLabel} a las ${hh}:${mn}` });\n      }\n      minutos += duracion;\n    }\n    if (slots.length >= 5) break;\n  }\n}\n\nconst profNombre = prof ? `${prof.titulo ?? ''} ${prof.nombre} ${prof.apellido}`.trim() : 'el profesional';\nconst servNombre = servicio?.nombre ?? 'la sesión';\n\nlet mensaje;\nif (slots.length === 0) {\n  mensaje = `Hola! 😊 No encontré turnos disponibles en los próximos 14 días con ${profNombre} para ${servNombre}. Escribinos directamente para coordinar: https://wa.me/543624075957`;\n} else {\n  const opciones = slots.map((s, i) => `${i + 1}. ${s.label}`).join('\\n');\n  mensaje = `Hola! 😊 Estos son los próximos turnos disponibles con ${profNombre} para ${servNombre}:\\n\\n${opciones}\\n\\nRespondé con el número de la opción que preferís y lo agendamos.`;\n}\n\nreturn [{ json: { from_raw: fromRaw, mensaje, slots } }];"
      },
