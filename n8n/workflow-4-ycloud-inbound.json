      "id": "node-wh-ycloud",
      "name": "Webhook YCloud",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parsear evento de YCloud (whatsapp.inbound_message.received)\nconst body = $input.first().json.body ?? $input.first().json;\n\n// Solo procesar mensajes entrantes\nif (body.type !== 'whatsapp.inbound_message.received') return [];\n\nconst msg = body.whatsappInboundMessage ?? {};\n\n// Ignorar si no hay remitente\nif (!msg.from) return [];\n\n// Ignorar mensajes del propio bot (loop prevention)\nif (msg.fromMe === true || msg.direction === 'outbound') return [];\n// Ignorar si el remitente es el número del negocio\nconst BOT_NUMBER = '5493625456570';\nif (msg.from === BOT_NUMBER || msg.from === '+' + BOT_NUMBER) return [];\n\nconst celular = msg.from; // formato E.164: 549XXXXXXXXXX\nconst tipo = msg.type ?? 'text';\n\nlet messageType = 'text';\nlet userText = '';\nlet mediaUrl = null;\nlet mediaMime = null;\nlet mediaName = null;\n\nif (tipo === 'text') {\n  messageType = 'text';\n  userText = msg.text?.body ?? '';\n} else if (tipo === 'image') {\n  messageType = 'image';\n  mediaUrl = msg.image?.link ?? null;\n  mediaMime = msg.image?.mime_type ?? 'image/jpeg';\n  userText = '[El paciente envió una imagen]';\n} else if (tipo === 'audio') {\n  messageType = 'audio';\n  mediaUrl = msg.audio?.link ?? null;\n  mediaMime = msg.audio?.mime_type ?? 'audio/mpeg';\n} else if (tipo === 'document') {\n  messageType = 'document';\n  mediaUrl = msg.document?.link ?? null;\n  mediaMime = msg.document?.mime_type ?? 'application/pdf';\n  mediaName = msg.document?.filename ?? 'documento';\n  userText = `[El paciente envió un documento: ${mediaName}]`;\n} else if (tipo === 'video') {\n  messageType = 'text';\n  userText = '[El paciente envió un video — consultame por texto o imagen]';\n} else if (tipo === 'interactive' && msg.interactive?.type === 'button_reply') {\n  messageType = 'button_reply';\n  userText = msg.interactive.button_reply.title ?? '';\n} else if (tipo === 'button') {\n  messageType = 'button_reply';\n  userText = msg.button?.payload ?? msg.button?.text ?? '';\n} else {\n  return [];\n}\n\nif (!userText && messageType === 'text') return [];\n\nreturn [{ json: { celular, messageType, userText, mediaUrl, mediaMime, mediaName } }];"
      },
      "id": "node-parse",
      "name": "Parsear Mensaje YCloud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "id": "1", "leftValue": "={{ $json.messageType }}", "rightValue": "text", "operator": { "type": "string", "operation": "equals" } }]
              }
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "id": "2", "leftValue": "={{ $json.messageType }}", "rightValue": "audio", "operator": { "type": "string", "operation": "equals" } }]
              }
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "id": "3", "leftValue": "={{ $json.messageType }}", "rightValue": "image", "operator": { "type": "string", "operation": "equals" } }]
              }
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "id": "4", "leftValue": "={{ $json.messageType }}", "rightValue": "document", "operator": { "type": "string", "operation": "equals" } }]
              }
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "id": "5", "leftValue": "={{ $json.messageType }}", "rightValue": "button_reply", "operator": { "type": "string", "operation": "equals" } }]
              }
            }
          ]
        },
        "options": {}
      },
