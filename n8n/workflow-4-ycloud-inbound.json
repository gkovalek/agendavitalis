      "parameters": {
        "jsCode": "const prev = $input.first().json;\nconst celular = prev.celular;\nconst titulo = prev.userText;\n\nlet accion = 'chat';\nif (titulo === 'Confirmo turno') accion = 'confirmar';\nelse if (titulo === 'Cancelo turno') accion = 'cancelar';\nelse if (titulo === 'Reagendar turno') accion = 'reagendar';\n\nlet userText = prev.userText;\nif (accion === 'reagendar') userText = 'Quiero reagendar mi turno';\n\nreturn [{ json: { celular, accion, userText, messageType: 'button_reply' } }];"
      },
