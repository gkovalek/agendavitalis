    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst binaryData = item.binary?.data;\nif (!binaryData) return [];\nconst prev = $node['Parsear Mensaje YCloud'].json;\nconst base64 = binaryData.data;\nconst mime = prev.mediaMime ?? 'audio/mpeg';\nreturn [{ json: { celular: prev.celular, audioBase64: base64, audioMimetype: mime } }];"
      },
